          DECODE_EXECUTE: begin
            cea = 0;
            v_cea = 0;
            write_to_vram = 0;  // Clear flag unless set by sta_write below

          /* verilator lint_off BLKSEQ */
          /* verilator lint_off UNUSEDSIGNAL */
          case (opcode)
            /* verilator lint_off VARHIDDEN */
            `include "cpu/decode_control_flow.svinc"
            `include "cpu/decode_load_store.svinc"
            `include "cpu/decode_store.svinc"
            `include "cpu/decode_inc_dec.svinc"
            `include "cpu/decode_adc_sbc.svinc"
            `include "cpu/decode_logic.svinc"
            `include "cpu/decode_shifts.svinc"
            `include "cpu/decode_compare.svinc"
            `include "cpu/decode_transfers.svinc"
            `include "cpu/decode_branches.svinc"
            `include "cpu/decode_flags_custom.svinc"
            /* verilator lint_on VARHIDDEN */
            // support more instructions here

            default: ;  // No operation.
          endcase
          /* verilator lint_on UNUSEDSIGNAL */
          /* verilator lint_on BLKSEQ */
          end
